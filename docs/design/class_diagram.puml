@startuml
' PlantUML Class Diagram for BattSync (WearBatteryMonitor)
' Shows MVVM architecture, feature modules, repository pattern, and relationships with Android SDK & Google Wearable Data Layer.

title BattSync (WearBatteryMonitor) - MVVM & System Architecture Class Diagram

package "Android SDK / Platform APIs" <<SDK>> {
    class ComponentActivity
    class Service
    class BroadcastReceiver
    class TileService
    class SuspendingComplicationDataSourceService
    class WearableListenerService
    class BatteryManager
    class BluetoothProfile
    class BluetoothHeadset
}

package "Google Play Services / Wearable Data Layer" <<Library>> {
    interface DataClient {
        + putDataItem()
        + addListener()
    }
    interface MessageClient {
        + sendMessage()
        + addListener()
    }
    interface CapabilityClient {
        + getCapability()
        + addListener()
    }
}

package "androidx.room (Database Layer)" <<Library>> {
    abstract class RoomDatabase
    interface Dao
}

' ==========================================
' Mobile Module (:mobile)
' ==========================================
package "com.echeeze.wearbatterymonitor (Mobile Module)" {

    package "mobile.ui" {
        class "MainActivity" as MobileMainActivity <<Activity>> {
            - viewModel: MainViewModel
            - phoneMonitor: PhoneBatteryMonitor
            - earphoneMonitor: EarphoneBatteryMonitor
            - wearDataSyncer: WearDataSyncer
            + onCreate()
            + onStart()
            + onStop()
        }

        class MainViewModel {
            - repository: BatteryRepository
            - _uiState: MutableStateFlow<MainUiState>
            + uiState: StateFlow<MainUiState>
            + loadHistoryFromDb()
            + updatePhoneBattery(...)
            + updateEarphoneBattery(...)
            + updateWatchBattery(...)
            + addHistoryEntry(...)
        }

        class MainUiState <<DataClass>> {
            + isLoading: Boolean
            + phonePercent: Int
            + phoneIsCharging: Boolean
            + phoneHistory: List<BatteryEntry>
            + watchPercent: Int?
            + watchIsCharging: Boolean
            + watchHistory: List<BatteryEntry>
            + earphonePercent: Int?
            + earphoneName: String?
            + earphoneHistory: List<BatteryEntry>
            + isServiceRunning: Boolean
            + graphRangeHours: Int
            + updateIntervalSeconds: Int
        }

        package "ui.components" {
            class BatterySection <<Composable>>
            class EarphoneSection <<Composable>>
            class HistoryGraph <<Composable>>
            class HistoryDetailDialog <<Composable>>
        }
    }

    package "mobile.monitor" {
        class PhoneBatteryMonitor {
            - context: Context
            - batteryReceiver: BroadcastReceiver
            + startMonitoring(): Pair<Int, Boolean>
            + stopMonitoring()
        }

        class EarphoneBatteryMonitor {
            - context: Context
            - bluetoothHeadset: BluetoothHeadset?
            + startMonitoring()
            + stopMonitoring()
            + updateFromProfile()
        }

        class NotificationHelper {
            - context: Context
            + createNotificationChannel()
            + createNotification(...): Notification
            + updateNotification(...)
        }
    }

    package "mobile.sync" {
        class WearDataSyncer {
            - context: Context
            - repository: BatteryRepository
            + startSyncing()
            + stopSyncing()
            + syncStatusToWear(...)
            + onDataChanged(...)
            + onMessageReceived(...)
        }
    }

    package "mobile.data" {
        entity BatteryEntry <<Entity>> {
            + deviceType: String
            + percent: Int
            + timestamp: Long
            + isCharging: Boolean
            + deviceName: String?
            + recordReason: String?
            + intervalSeconds: Int?
        }

        interface BatteryDao <<Dao>> {
            + getHistoryByType(type: String): List<BatteryEntry>
            + insert(entry: BatteryEntry)
            + trimHistory(type: String, limit: Int)
        }

        abstract class AppDatabase {
            + {abstract} batteryDao(): BatteryDao
            + {static} getDatabase(context): AppDatabase
        }

        interface BatteryRepository {
            + getHistoryByType(type: String): List<BatteryEntry>
            + insertEntry(entry: BatteryEntry)
            + trimHistory(type: String, limit: Int)
            + syncStatusToWear(...)
        }

        class BatteryRepositoryImpl {
            - context: Context
            - batteryDao: BatteryDao
            + getHistoryByType(type: String): List<BatteryEntry>
            + insertEntry(entry: BatteryEntry)
            + trimHistory(type: String, limit: Int)
            + syncStatusToWear(...)
        }
    }

    class BatteryMonitorService <<Service>> {
        - repository: BatteryRepository
        - notificationHelper: NotificationHelper
        - phoneMonitor: PhoneBatteryMonitor
        - earphoneMonitor: EarphoneBatteryMonitor
        - wearDataSyncer: WearDataSyncer
        + onCreate()
        + onDestroy()
        + syncAllData()
    }
}

' ==========================================
' Relationships & Inheritances
' ==========================================

ComponentActivity <|-- MobileMainActivity
Service <|-- BatteryMonitorService
RoomDatabase <|-- AppDatabase

' MVVM Relationships
MobileMainActivity --> MainViewModel : observes
MainViewModel --> MainUiState : holds
MainViewModel --> BatteryRepository : uses

' Service & Feature Modules Relationships
BatteryMonitorService --> PhoneBatteryMonitor : uses
BatteryMonitorService --> EarphoneBatteryMonitor : uses
BatteryMonitorService --> NotificationHelper : uses
BatteryMonitorService --> WearDataSyncer : uses
BatteryMonitorService --> BatteryRepository : uses

MobileMainActivity --> PhoneBatteryMonitor : uses
MobileMainActivity --> EarphoneBatteryMonitor : uses
MobileMainActivity --> WearDataSyncer : uses

' Repository Relationships
BatteryRepository <|.. BatteryRepositoryImpl
BatteryRepositoryImpl --> BatteryDao : uses
AppDatabase --> BatteryDao : provides
BatteryDao ..> BatteryEntry : uses

@uml
